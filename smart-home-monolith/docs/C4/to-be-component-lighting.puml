@startuml LightingService_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' === Контейнер ===
Container_Boundary(lighting_service, "Lighting Service (Python)") {

  ' === Ядро сервиса ===
  Component(controller, "Lighting Controller", "Основная бизнес-логика освещения")
  Component(scheduler, "Schedule Manager", "Управление расписаниями c учетом пользовательских сценариев")
  
  ' === Обработка данных ===
  Component(data_filter, "Data Filter", "Фильтрация и валидация данных")

  ' === Работа с хранилищами ===
  Component(redis_client, "Redis Client", "Кеширование состояний")
  Component(tsdb_writer, "TSDB Writer", "Запись агрегированных данных")
  Component(event_producer, "Kafka Producer", "Отправка команд устройствам")
  Component(event_consumer, "Kafka Consumer", "Получение событий датчиков и расписаний")

  ' === Взаимодействия ===
  controller --> scheduler : "Получить расписание"
  event_consumer --> data_filter : "Сырые данные (освещенность, движение)"
  data_filter --> controller : "Обработанные события"
  controller --> event_producer : "Команды устройствам"
  controller --> redis_client : "Обновить/получить состояния"
  data_filter --> tsdb_writer : "Агрегированные данные"
  data_filter --> event_producer : "События для аналитики"
  event_consumer --> controller : "Обновления по расписанию"
}

' === Внешние зависимости ===
System_Ext(api_gw, "API Gateway", "KONG")
System_Ext(event_bus, "Event Bus", "Kafka")
System_Ext(redis, "Redis", "Кеш состояний")
System_Ext(tsdb, "TimescaleDB", "Агрегированные данные")

' === Ключевые связи ===
api_gw --> controller : "REST /lighting/*"
event_bus --> event_consumer : "События датчиков, расписания"
redis_client --> redis : "SET/GET"
tsdb_writer --> tsdb : "INSERT"
event_producer --> event_bus : "Команды
api_gw <-- scheduler: "REST/actions/*"